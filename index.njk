{% extends "layouts/index.njk" %}
{% block content %}
<section class="header">
    {% include "components/ascii-title.njk" %}
    <p>
        <i>I do software, electronics and high-powered lawn darts 🚀</i>
    </p>
</section>
<section id="projects">
    <h2>Projects</h2>
    Projects on this website are written in a blog format, focusing on the project from my perspective. The Github
    documentation (if attached) is more technical and documentational than this.

    <br>
    <br>

    <span
        style="opacity: 1; background-color: rgba(200, 142, 25, 0.262);padding: 1rem;border-radius: 10px;border: thin solid rgb(136, 88, 0);">
        <strong>
            Just note that this will look empty for a while. This is all new and I'm in the process of writing it all
            up!
        </strong>
        <br>
        I have like 10 projects to put on here but I've just done 1 for initial setup. I will delete this when it is up
        to date
    </span>

    <table id="project-table">
        <thead>
            <tr>
                <th>Name</th>
                <th class="tags-col">Tags</th>
                <th>Decription</th>
            </tr>
        </thead>
        <tbody>
            {% for project in collections.project | sort(attribute='data.year') | reverse %}
            <tr>
                <td class="name-col">
                    <div class="title-subtitle">
                        <a href="{{ project.url }}">{{ project.data.title }}</a>
                        <span class="subtitle-year">{{ project.data.date_display }}</span>
                    </div>

                    {# duplicate tags for mobile only #}
                    <div class="tags-mobile">
                        {% for tag in project.data.tags | sort %}
                        {% if tag != "project" %}
                        <span class="tag {{tag}}">{{ tag }}</span>
                        {% endif %}
                        {% endfor %}
                    </div>
                </td>

                <td class="tags-col">
                    {% for tag in project.data.tags | sort %}
                    {% if tag != "project" %}
                    <span class="tag {{tag}}">{{ tag }}</span>
                    {% endif %}
                    {% endfor %}
                </td>

                <td>{{ project.data.description }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</section>
<section id="job-history-section" class="job-history-section" aria-labelledby="job-history-heading">
    <h2 id="job-history-heading">Job History</h2>

    <div class="company-logos">
        {% for employer in job_history %}
        <div class="logo">
            <img src="assets/images/company_logos/{{ employer.logo }}" alt="{{ employer.company }}"
                id="{{ employer.logo | replace('.', '-') }}">
        </div>
        {% endfor %}
    </div>

    <div class="job-timeline">
        {% for employer in job_history %}
        <article class="job-employer">
            <header class="job-employer__header">
                <h3 class="job-employer__name">{{ employer.company }}</h3>
            </header>
            <div class="job-employer__positions">
                {% for position in employer.positions %}
                <div class="job-position">
                    <h4 class="job-position__title">{{ position.title }}</h4>
                    <p class="job-position__dates"><span class="subtitle-year">{{ position.year_start }} – {{
                            position.year_end }}</span></p>
                    <ul class="job-position__highlights">
                        {% for highlight in position.highlights %}
                        <li>{{ highlight }}</li>
                        {% endfor %}
                    </ul>
                </div>
                {% endfor %}
            </div>
        </article>
        {% endfor %}
    </div>
</section>
<section id="links">
    <h2>Links</h2>
    <ul>
        <li class="linkedin"><a href="https://www.linkedin.com/in/freddy-mcloughlan/">Linkedin</a></li>
        <li class="github"><a href="https://github.com/mcloughlan">Github</a></li>
        <li class="algo"><a href="https://algo.mcloughlan.com/">Algo Notes</a></li>
        <li class="stackoverflow"><a href="https://stackoverflow.com/users/14141223/freddy-mcloughlan">Stack
                Overflow</a></li>
        <li><a href="r.html">???</a></li>
    </ul>
</section>
{% endblock %}